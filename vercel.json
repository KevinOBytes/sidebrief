{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "website",
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/KevinOBytes/sidebrief/releases/latest/download/Sidebrief.dmg",
      "permanent": false
    },
    {
      "source": "/dmg",
      "destination": "https://github.com/KevinOBytes/sidebrief/releases/latest/download/Sidebrief.dmg",
      "permanent": false
    },
    {
      "source": "/downloads/Sidebrief.dmg",
      "destination": "https://github.com/KevinOBytes/sidebrief/releases/latest/download/Sidebrief.dmg",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/KevinOBytes/sidebrief",
      "permanent": false
    },
    {
      "source": "/repo",
      "destination": "https://github.com/KevinOBytes/sidebrief",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
