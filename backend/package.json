{
  "name": "sidebrief-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Sidebrief backend API for sync, retrieval, and auth",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@neondatabase/serverless": "^0.10.4",
    "hono": "^4.7.2",
    "nodemailer": "^10.0.10",
    "resend": "^6.28.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
